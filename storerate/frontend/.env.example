# Base URL for API calls. Leave as /api to use the Vite dev-server proxy (see vite.config.js).
VITE_API_BASE_URL=/api
# Where the dev server forwards /api requests
VITE_PROXY_TARGET=http://localhost:4000
# Show one-click demo credentials on the login page (set to false for demos/production)
VITE_SHOW_DEMO_CREDENTIALS=true
