# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgres://storerate:storerate@localhost:5432/storerate
TEST_DATABASE_URL=postgres://storerate:storerate@localhost:5432/storerate_test

# Auth — use a long random string in real deployments, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret-string-0123456789
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# CORS: comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173

# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=50
